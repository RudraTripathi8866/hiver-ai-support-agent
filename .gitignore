# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
*.pem
*.key

# IDE / Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local Data files (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/golden/*
!data/golden/.gitkeep

# Generated Outputs & Cache
outputs/*
!outputs/.gitkeep
report/*.pdf
report/*.docx
!report/.gitkeep
