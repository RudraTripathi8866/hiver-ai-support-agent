# LLM Provider Configuration (e.g., openai, anthropic, or local)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small

# Data Paths
RAW_DATA_PATH=data/raw/customer_support.csv
PROCESSED_DATA_PATH=data/processed/cleaned_conversations.parquet
GOLDEN_DATA_PATH=data/golden/golden_evaluation_set.jsonl

# Pipeline Settings
TARGET_BRAND=AmazonHelp
TOP_K_RETRIEVAL=3
CONFIDENCE_THRESHOLD=0.75
